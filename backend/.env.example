# ----- Environment -----
# development | staging | production
ENVIRONMENT=development

# ----- 데이터 소스 모드 (사내 이관 — docs/internal-migration-mode-switch-runbook.md) -----
# DATA_MODE: dev=외부 크롤/PDF 정형화 테스트(개발 적재 스크립트 허용) / prod=폐쇄망 Oracle+수집기(스크립트 차단)
DATA_MODE=dev
# REGISTRY_SOURCE(등기부 읽기): pdf=외부 8100 API(현행) / auto=고유번호 있으면 nice_rles_* 아니면 pdf / db=항상 내부 6테이블(폐쇄망)
REGISTRY_SOURCE=pdf
# INTERNAL_ONLY: true=크롤·더미 차단, ETL된 내부형식(CCTR_*/nice_rles_*)만. 확인 못하면 "확인 불가"
INTERNAL_ONLY=false
# 정보계 Oracle (#1 운영 ETL: oracle_to_pg_etl). 운영 전환 = 이 3줄만 사내 정보계로 교체.
# dev 로컬 시뮬레이터: docker compose --profile oracle up -d oracle → ORACLE_DSN=oracle:1521/FREEPDB1 (kbsrc/kbsrc)
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# ----- Database -----
# 본 앱은 수집기와 동일 PostgreSQL을 공유 (ADR-002)
DATABASE_URL=postgresql://kb_user:kb_password@localhost:5433/kb_estate

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- API server -----
API_HOST=0.0.0.0
API_PORT=8002

# ----- CORS -----
# 콤마로 구분. 운영에서는 실제 도메인만 허용
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- JWT (Phase 1b에서 사용) -----
# 운영에서는 반드시 강한 랜덤값으로 교체. `openssl rand -hex 32` 등으로 생성
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----- LLM / OpenAI (Phase 3에서 사용, ADR-008) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_DAILY_CALL_LIMIT=1000

# ----- Logging / Observability -----
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ----- Rate limiting -----
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# ----- Object storage (Phase 2에서 첨부파일 도입 시) -----
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=newtech-uploads
